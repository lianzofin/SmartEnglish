<!DOCTYPE html>
<html lang="he" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    @* ספריית העיצוב בגרסה לעברית (RTL) *@
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.rtl.min.css"]" />

    @* הגופנים והעיצוב המותאם של האתר *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&family=Rubik:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    <link rel="stylesheet" href="@Assets["View.styles.css"]" />
    <ImportMap />

    @* סמל האתר בלשונית הדפדפן *@
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="pageRenderMode" />
</head>

<body>
    @* טעינת דפי האתר בהתאם לניווט *@
    <Routes @rendermode="pageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly IComponentRenderMode pageRenderMode =
        new InteractiveServerRenderMode(prerender: false);
}