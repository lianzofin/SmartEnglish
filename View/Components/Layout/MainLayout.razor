@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject NavigationManager Navigation

@* נוצר בגרסה 1 מהתבנית, ונכתב מחדש בגרסה 4. עודכן בגרסה 6 להצגת משתמש מחובר *@

@* סרגל עליון שנשאר צמוד לראש המסך גם בגלילה *@
<header class="topbar sticky-top">
    <div class="container d-flex align-items-center justify-content-between py-3">
        <Logo />
        <nav class="d-flex align-items-center gap-3">
            @if (Session.IsLoggedIn)
            {
                <span class="fw-semibold">שלום, @Session.FullName</span>
                <button class="btn btn-outline-primary" type="button" @onclick="Logout">יציאה</button>
            }
            else
            {
                <span class="fw-semibold">שלום, אורח</span>
                <a class="btn btn-outline-primary" href="login">כניסה</a>
                <a class="btn btn-primary" href="register">הרשמה</a>
            }
        </nav>
    </div>
</header>

@* כאן נכנס התוכן של הדף שהנתב בחר *@
<main>
    @Body
</main>

@* תחתית האתר *@
<footer class="py-4 text-secondary small">
    <div class="container d-flex flex-wrap justify-content-between gap-2">
        <span>SmartEnglish · לומדים אנגלית בחכמה</span>
        <span>פרויקט גמר בהנדסת תוכנה</span>
    </div>
</footer>

@* הודעה שמופיעה בתחתית המסך כשקורית שגיאה לא צפויה. מוסתרת עד שיש שגיאה *@
<div id="blazor-error-ui" data-nosnippet>
    אירעה שגיאה.
    <a href="." class="reload">רענון</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        // נרשמים לאירוע שינוי המשתמש
        Session.OnChange += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        // מעדכנים את התצוגה של הסרגל
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("");
    }

    public void Dispose()
    {
        // מבטלים את ההרשמה לאירוע כשהסרגל נסגר
        Session.OnChange -= OnSessionChanged;
    }
}