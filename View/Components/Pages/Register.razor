@page "/register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Mail
@using Model
@inject HttpClient Http
@inject NavigationManager Navigation

@* דף ההרשמה של SmartEnglish - גרסה 5 *@
<PageTitle>הרשמה · SmartEnglish</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="card app-card-preview shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h2 fw-bold text-dark">הרשמה</h1>
                    <p class="text-secondary mb-4">פותחים חשבון תלמיד ומצטרפים לחוג האנגלית.</p>

                    <form novalidate>
                        @* שדות הטופס מחוברים בקישור דו-כיווני *@
                        <Field Id="reg-fullname" Label="שם מלא" Name="fullName" @bind-Value="fullName" />
                        <Field Id="reg-username" Label="שם משתמש" Name="username" @bind-Value="username" />
                        <Field Id="reg-email" Label="אימייל" Name="email" Type="email" Dir="ltr" @bind-Value="email" />
                        <Field Id="reg-password" Label="סיסמה" Name="password" Type="password" Dir="ltr" @bind-Value="password" />
                        <Field Id="reg-confirm" Label="אימות סיסמה" Name="confirmPassword" Type="password" Dir="ltr" @bind-Value="confirmPassword" />

                        @* התרעת שגיאה *@
                        @if (errorMessage != null)
                        {
                            <div class="alert alert-danger my-3" role="alert">@errorMessage</div>
                        }

                        @* התרעת הצלחה *@
                        @if (isRegistered)
                        {
                            <div class="alert alert-success my-3" role="status">
                                <strong>ההרשמה הושלמה בהצלחה!</strong> מעבירים אותך לעמוד הכניסה בעוד @secondsLeft שניות...
                            </div>
                        }

                        @* כפתור השליחה *@
                        <button class="btn btn-primary btn-lg w-100 mt-3" type="button"
                                disabled="@(isBusy || isRegistered)" @onclick="RegisterAsync">
                            @(isBusy ? "בודקים..." : "הרשמה לחוג")
                        </button>
                    </form>
                </div>
            </div>

            <p class="text-center mt-4 text-secondary">כבר רשומים לחוג? <a class="fw-bold text-primary text-decoration-none" href="login">לכניסה</a></p>

        </div>
    </div>
</div>

@code {
    private string? fullName;
    private string? username;
    private string? email;
    private string? password;
    private string? confirmPassword;

    private string? errorMessage;
    private bool isBusy;
    private bool isRegistered;
    private int secondsLeft = 5;

    private async Task RegisterAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(username)
            || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password)
            || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "יש למלא את כל השדות.";
            return;
        }

        if (!MailAddress.TryCreate(email.Trim(), out _))
        {
            errorMessage = "כתובת האימייל לא תקינה.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "הסיסמה ואימות הסיסמה לא זהים.";
            return;
        }

        isBusy = true;
        try
        {
            bool usernameExists = await Http.GetFromJsonAsync<bool>($"api/users/exists/{Uri.EscapeDataString(username.Trim())}");
            if (usernameExists)
            {
                errorMessage = "שם המשתמש כבר תפוס. בחרו שם אחר.";
                return;
            }

            bool emailExists = await Http.GetFromJsonAsync<bool>($"api/users/email-exists/{Uri.EscapeDataString(email.Trim())}");
            if (emailExists)
            {
                errorMessage = "האימייל הזה כבר רשום במערכת.";
                return;
            }

            User newUser = new User
            {
                FullName = fullName.Trim(),
                Username = username.Trim(),
                Email = email.Trim(),
                Password = password
            };

            HttpResponseMessage response = await Http.PostAsJsonAsync("api/users", newUser);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "ההרשמה נכשלה. נסו שוב.";
                return;
            }
        }
        catch (Exception ex)
        {
            // הדפסת השגיאה המדויקת לצורך זיהוי התקלה
            errorMessage = $"שגיאת תקשורת: {ex.Message}" + (ex.InnerException != null ? $" | פנימי: {ex.InnerException.Message}" : "");
            return;
        }
        finally
        {
            isBusy = false;
        }

        isRegistered = true;
        while (secondsLeft > 0)
        {
            StateHasChanged();
            await Task.Delay(1000);
            secondsLeft--;
        }

        Navigation.NavigateTo("login");
    }
}