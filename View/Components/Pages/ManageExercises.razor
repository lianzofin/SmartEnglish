@page "/teacher/exercises"
@inject View.Services.UserSession Session
@inject NavigationManager Nav

<PageTitle>ניהול תרגילים · SmartEnglish</PageTitle>

@* דף ניהול תרגילים - מאפשר הוספת תרגיל חדש וצפייה במאגר הקיים. מוגן ל-Teacher ו-Admin *@
@if (Session.IsLoggedIn && (Session.RoleName == "Teacher" || Session.RoleName == "Admin"))
{
    <div class="container py-4 py-md-5">
        @* באנר עליון *@
        <div class="page-banner mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h3 fw-bold mb-1">ניהול מאגר תרגילים</h1>
                <p class="text-secondary mb-0">יצירת שאלות תרגול חדשות ועריכת תרגילים קיימים באתר.</p>
            </div>
            <a href="@(Session.RoleName == "Admin" ? "/admin" : "/teacher")" class="btn btn-outline-primary">
                חזרה לדף הראשי
            </a>
        </div>

        <div class="row g-4">
            @* טופס עיצובי להוספת תרגיל חדש *@
            <div class="col-12 col-lg-5">
                <div class="dashboard-card">
                    <h2 class="h5 fw-bold mb-3">הוספת תרגיל חדש</h2>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">כותרת התרגיל</label>
                        <input type="text" class="form-control" placeholder="לדוגמה: אוצר מילים - מסעדות" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">קטגוריה</label>
                            <select class="form-select">
                                <option>אוצר מילים</option>
                                <option>דקדוק</option>
                                <option>הבנת הנקרא</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">רמת קושי</label>
                            <select class="form-select">
                                <option>מתחילים (A1-A2)</option>
                                <option>בינוני (B1)</option>
                                <option>מתקדמים (B2-C1)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">תוכן השאלה (באנגלית)</label>
                        <textarea class="form-control english-text" rows="2" placeholder="Choose the correct word to complete the sentence..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">התשובה הנכונה</label>
                        <input type="text" class="form-control english-text" placeholder="Correct answer" />
                    </div>

                    <button type="button" class="btn btn-primary w-100 fw-semibold">שמירת תרגיל במאגר</button>
                </div>
            </div>

            @* רשימת תרגילים קיימים לדוגמה *@
            <div class="col-12 col-lg-7">
                <div class="dashboard-card h-100">
                    <h2 class="h5 fw-bold mb-3">תרגילים קיימים במערכת</h2>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>שם התרגיל</th>
                                    <th>קטגוריה</th>
                                    <th>רמה</th>
                                    <th class="text-end">פעולות</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-semibold">Travel & Airport</td>
                                    <td>אוצר מילים</td>
                                    <td><span class="status-pill status-pill-success">בינוני</span></td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary">ערוך</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Present Tenses</td>
                                    <td>דקדוק</td>
                                    <td><span class="status-pill status-pill-warning">מתחילים</span></td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary">ערוך</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Tech & Innovation</td>
                                    <td>הבנת הנקרא</td>
                                    <td><span class="status-pill status-pill-success">מתקדמים</span></td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary">ערוך</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
        }
        else if (Session.RoleName != "Teacher" && Session.RoleName != "Admin")
        {
            Nav.NavigateTo("/access-denied");
        }
    }
}