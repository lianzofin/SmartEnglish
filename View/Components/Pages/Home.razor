@page "/"

@* נוסף בגרסה 4 - דף הבית המעודכן עבור SmartEnglish *@

<PageTitle>SmartEnglish · מרכז ללימודי אנגלית</PageTitle>

@* ===== 1. HERO SECTION: פתיחה ===== *@
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge bg-primary-light text-primary fw-bold mb-3 px-3 py-2 rounded-pill fs-6">
                    ✨ לומדים אנגלית בדרך חדשה
                </span>
                <h1 class="display-4 fw-bold mb-3">
                    החוג שלכם לאנגלית, <br />
                    <span class="text-primary">עכשיו גם בבית.</span>
                </h1>
                <p class="lead text-secondary mb-4">
                    SmartEnglish מחברת בין השיעור הפרונטלי לתרגול אינטראקטיבי בבית. התלמידים נהנים מתרגול אוצר מילים, דקדוק ומשוב מיידי, והמורים מקבלים תמונה מלאה על ההתקדמות והנוכחות.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-primary btn-lg px-4 py-3 fw-bold" href="register">להרשמה למערכת</a>
                    <a class="btn btn-outline-primary btn-lg px-4 py-3 fw-semibold" href="login">כניסה לרשומים</a>
                </div>
            </div>

            @* תצוגה מקדימה של הלומדה בצורת Widget אפליקציה *@
            <div class="col-lg-5" aria-hidden="true">
                <div class="app-card-preview p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-primary text-white px-3 py-2 rounded-pill">תרגול יומאי · Present Simple</span>
                        <span class="badge badge-score px-3 py-2 rounded-pill">⭐ +150 נקודות</span>
                    </div>

                    <h6 class="fw-bold text-dark mb-3">השלימו את המשפט הנכון:</h6>

                    @* קופסת השאלה - מוצגת משמאל לימין *@
                    <div class="p-3 mb-3 rounded-3 bg-light border english-text">
                        <p class="fs-5 mb-0 fw-medium">"We ___ English at our weekly club."</p>
                    </div>

                    @* אפשרויות התשובה - מוצגות משמאל לימין *@
                    <div class="d-flex flex-column gap-2 mb-3 english-text">
                        <div class="p-3 rounded-3 border border-2 border-success bg-success-subtle d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-success">A. study</span>
                            <span class="badge bg-success">✓ תשובה נכונה</span>
                        </div>
                        <div class="p-3 rounded-3 border bg-white d-flex justify-content-between align-items-center opacity-75">
                            <span>B. studies</span>
                            <span class="text-secondary small">תשובה שגויה</span>
                        </div>
                    </div>

                    <div class="pt-2 border-top">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>התקדמות במסלול הלימוד</span>
                            <span class="fw-bold text-primary">80% הושלם</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-primary rounded-pill" style="width: 80%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

