@page "/login"
@using System.Net
@using Model
@inject HttpClient Http
@inject UserSession Session
@inject NavigationManager Navigation

@* דף התחברות למערכת עם ניתוב לדף הראשי של המשתמש לפי תפקידו *@
<PageTitle>כניסה · SmartEnglish</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="card app-card-preview shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h2 fw-bold text-dark">כניסה</h1>
                    <p class="text-secondary mb-4">היכנסו לחשבון כדי להמשיך לתרגל ולצבור נקודות.</p>

                    <form novalidate>
                        @* שדות הטופס המקושרים למשתני הדף *@
                        <Field Id="login-username" Label="שם משתמש" Name="username" @bind-Value="username" />
                        <Field Id="login-password" Label="סיסמה" Name="password" Type="password" Dir="ltr" @bind-Value="password" />

                        @* הצגת הודעת שגיאה במידת הצורך *@
                        @if (errorMessage != null)
                        {
                            <div class="alert alert-danger my-3" role="alert">@errorMessage</div>
                        }

                        <button class="btn btn-primary btn-lg w-100 mt-3" type="button"
                                disabled="@isBusy" @onclick="LoginAsync">
                            @(isBusy ? "מתחברים..." : "כניסה למערכת")
                        </button>
                    </form>
                </div>
            </div>

            <p class="text-center mt-4 text-secondary">אין לך חשבון? <a class="fw-bold text-primary text-decoration-none" href="register">להרשמה</a></p>

        </div>
    </div>
</div>

@code {
    private string? username;
    private string? password;
    private string? errorMessage;
    private bool isBusy;

    // פעולת ההתחברות: שולחת פרטים לשרת, שומרת את המשתמש ומעבירה לדף המתאים לתפקיד
    private async Task LoginAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "יש למלא שם משתמש וסיסמה.";
            return;
        }

        isBusy = true;
        try
        {
            User credentials = new User
            {
                Username = username.Trim(),
                Password = password
            };

            HttpResponseMessage response = await Http.PostAsJsonAsync("api/users/login", credentials);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                errorMessage = "שם המשתמש או הסיסמה שגויים.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            User? user = await response.Content.ReadFromJsonAsync<User>();
            if (user == null)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            // שמירת פרטי המשתמש המחובר בשירות
            Session.Login(user);

            // שינוי בגרסה 8: מעבר לדף הראשי המתאים לפי תפקיד המשתמש במקום לדף הבית הכללי
            if (user.RoleName == "Admin")
            {
                Navigation.NavigateTo("/admin");
            }
            else if (user.RoleName == "Teacher")
            {
                Navigation.NavigateTo("/teacher");
            }
            else if (user.RoleName == "Student")
            {
                Navigation.NavigateTo("/student");
            }
            else
            {
                Navigation.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"שגיאת תקשורת: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}