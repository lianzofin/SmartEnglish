<div class="mb-3">
    @* תווית השדה מקושרת באמצעות ה-ID *@
    <label class="form-label fw-medium" for="@Id">
        @Label <span class="text-danger" aria-hidden="true">*</span>
    </label>

    @* שדה קלט התומך בקישור דו-כיווני ועדכון ערך באירוע שינוי *@
    <input class="form-control form-control-lg" id="@Id" name="@Name" type="@Type" dir="@Dir" required
           value="@Value" @onchange="OnValueChanged" />
</div>

@code {
    // מזהה השדה
    [Parameter] public string Id { get; set; } = "";

    // טקסט התווית
    [Parameter] public string Label { get; set; } = "";

    // שם השדה בטופס
    [Parameter] public string? Name { get; set; }

    // סוג הקלט (טקסט, אימייל, סיסמה וכו')
    [Parameter] public string Type { get; set; } = "text";

    // כיוון הכתיבה (RTL / LTR)
    [Parameter] public string? Dir { get; set; }

    // הערך הנוכחי בשדה הקלט
    [Parameter] public string? Value { get; set; }

    // אירוע עדכון הערך עבור קישור דו-כיווני (Bind)
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    // עדכון הערך והפעלת האירוע בעת שינוי הקלט
    private Task OnValueChanged(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}